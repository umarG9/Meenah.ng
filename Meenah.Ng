<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Meenah.Ng - Data & Airtime</title><style>@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;900&display=swap');*{box-sizing:border-box;font-family:'Outfit',system-ui;margin:0;padding:0}body{background:#06000f;color:#fff;min-height:100vh}body::before{content:'';position:fixed;inset:0;background:radial-gradient(600px at 0% 0%,#4a148c 0%,transparent 50%),radial-gradient(800px at 100% 100%,#ff2e93 0%,transparent 50%);z-index:-1}.h{background:linear-gradient(135deg,rgba(74,20,140,.9),rgba(123,47,247,.9),rgba(255,46,147,.8));backdrop-filter:blur(20px);padding:22px 20px;text-align:center;border-bottom:1px solid rgba(255,255,255,.1);box-shadow:0 10px 40px rgba(123,47,247,.3)}.h h1{font-weight:900;font-size:32px}.h h1 span{background:linear-gradient(#fff,#ff8a00);-webkit-background-clip:text;-webkit-text-fill-color:transparent}.pill{display:inline-block;background:rgba(0,0,0,.3);padding:6px 14px;border-radius:20px;font-size:11px;margin-top:8px;border:1px solid rgba(255,255,255,.15)}.c{background:linear-gradient(135deg,rgba(255,255,255,.08),rgba(255,255,255,.04));backdrop-filter:blur(20px);margin:12px;padding:18px;border-radius:22px;border:1px solid rgba(255,255,255,.12);box-shadow:0 8px 30px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.1)}.bal{background:linear-gradient(135deg,#7b2ff7 0%,#ff2e93 50%,#ff8a00 100%);padding:24px;border-radius:22px;text-align:center;position:relative;overflow:hidden;box-shadow:0 15px 35px rgba(123,47,247,.5)}.bal::before{content:'';position:absolute;inset:0;background:linear-gradient(45deg,transparent 30%,rgba(255,255,255,.15) 50%,transparent 70%);animation:shine 3s infinite}@keyframes shine{0%{transform:translateX(-100%)}100%{transform:translateX(100%)}}input,select{width:100%;padding:14px 16px;margin:7px 0;border-radius:14px;border:1px solid rgba(255,255,255,.15);background:rgba(0,0,0,.3);color:#fff;font-size:14px}button{width:100%;padding:14px;margin:7px 0;border-radius:14px;border:none;background:linear-gradient(135deg,#7b2ff7,#ff2e93);color:#fff;font-weight:900;font-size:14px;box-shadow:0 6px 20px rgba(123,47,247,.4);cursor:pointer}.hidden{display:none!important}.tab{width:auto;padding:10px 18px;border-radius:25px;margin:4px;font-size:13px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12)}.tab.active{background:#fff;color:#4a148c;font-weight:900}.plan{padding:14px 10px;border-radius:16px;text-align:center;background:linear-gradient(135deg,rgba(255,255,255,.08),rgba(255,255,255,.03));border:1px solid rgba(255,255,255,.1);cursor:pointer}.plan.active{background:linear-gradient(135deg,#fff,#e0c3ff);color:#4a148c;transform:scale(1.05)}.network-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:10px 0}.net-card{padding:12px 6px;border-radius:14px;text-align:center;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);cursor:pointer;font-size:11px;font-weight:700}.net-card.active{background:#fff;color:#000}.modal{position:fixed;inset:0;background:rgba(6,0,15,.92);backdrop-filter:blur(20px);z-index:99;display:flex;align-items:center;justify-content:center;padding:16px}.bank-btn{padding:12px;border-radius:12px;font-size:11px;font-weight:700;text-align:center;cursor:pointer;border:1px solid rgba(255,255,255,.2)}.bank-btn.active{background:#fff;color:#000}</style></head><body>
<div class="h"><h1>💎 Meenah<span>.Ng</span></h1><p style="font-size:12px;opacity:.9">Data & Airtime • Cheapest & Fastest</p><div class="pill" id="balT">₦0 • Wallet Balance</div></div>

<div id="login" class="c" style="margin-top:30px;text-align:center"><div style="font-size:50px;margin-bottom:10px">💎</div><h3 style="font-size:22px">Barka da zuwa</h3><p style="font-size:12px;opacity:.6;margin:8px 0 15px">Mafi rahusa a Nigeria</p><input id="ph" value="07012869066" placeholder="Phone number"><button onclick="sO()">Tura OTP ✨</button><div id="s2" class="hidden" style="margin-top:12px"><p style="font-size:13px">OTP: <b id="oD" style="background:linear-gradient(135deg,#7b2ff7,#ff2e93);padding:6px 12px;border-radius:10px"></b></p><input id="oI" placeholder="Shigar da OTP" style="margin-top:10px"><button onclick="vO()">Tabbatar OTP ✅</button></div><div id="s4" class="hidden" style="margin-top:12px"><input id="pS" type="password" placeholder="Saka PIN (4 digits)" maxlength="4"><button onclick="fin()">Shiga Meenah.Ng 🚀</button></div></div>

<div id="app" class="hidden">
<div class="c bal"><div style="position:relative;z-index:1"><p style="font-size:11px;opacity:.9;letter-spacing:1px">WALLET BALANCE</p><h1 id="bN" style="font-size:38px;margin:6px 0">₦0</h1><div style="background:rgba(0,0,0,.25);display:inline-block;padding:5px 12px;border-radius:20px;font-size:10px">💳 PalmPay • SmartCash</div></div></div>

<div class="c" style="display:flex;justify-content:center;flex-wrap:wrap"><button onclick="tab('dep')" id="t-dep" class="tab active">💰 Deposit</button><button onclick="tab('data')" id="t-data" class="tab">📱 Data</button><button onclick="tab('air')" id="t-air" class="tab">📞 Airtime</button><button onclick="tab('hist')" id="t-hist" class="tab">📜 History</button></div>

<div id="dep" class="c"><h3>💰 Deposit - Zabi Banki</h3><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0"><div onclick="selBank('palmpay')" id="b-palmpay" class="bank-btn active">PalmPay<br><b>09026133849</b></div><div onclick="selBank('smartcash')" id="b-smartcash" class="bank-btn" style="background:rgba(255,0,0,.15)">SmartCash<br><b>07012869066</b></div></div>
<div id="palmpay-info" style="background:linear-gradient(135deg,#6a0dad,#7b2ff7);padding:14px;border-radius:14px;text-align:center;border:1px solid rgba(255,255,255,.2)"><p style="font-size:11px;opacity:.8">PalmPay</p><h2 style="letter-spacing:1px;margin:4px 0">090261
